[Unit]
Description=Retail entrance monitoring dashboard
After=network.target retail-roboflow-inference.service
Wants=retail-roboflow-inference.service

[Service]
Type=simple
User=arduino
Group=arduino
WorkingDirectory=/home/arduino/retail-entrance-counter
Environment=PYTHONPATH=/home/arduino/retail-entrance-counter/src
ExecStart=/usr/bin/python3 -m retail_counter.web_server --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

